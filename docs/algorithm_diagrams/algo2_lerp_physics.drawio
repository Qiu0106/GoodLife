        <mxCell id="draw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c65911;fontSize=16;" value="计算闪烁 alpha (sin函数)&#xa;绘制圆形到 Canvas" vertex="1">
