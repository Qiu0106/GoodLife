        <mxCell id="lerpPos" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" value="bgStar.x = lerp(x, homeX, 0.02)&#xa;bgStar.y = lerp(y, homeY, 0.02)" vertex="1">
