<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elderly_brand_light" />
            <corners android:radius="@dimen/elderly_corner_radius" />
            <stroke android:width="3dp" android:color="@color/elderly_brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/elderly_surface" />
            <corners android:radius="@dimen/elderly_corner_radius" />
            <stroke android:width="2dp" android:color="@color/elderly_input_border" />
        </shape>
    </item>
</selector>
