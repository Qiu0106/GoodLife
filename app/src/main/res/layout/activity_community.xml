<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/elderly_bg">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/elderly_surface"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="@color/elderly_brand"
        app:tabIndicatorHeight="4dp"
        app:tabIndicatorFullWidth="true"
        app:tabRippleColor="@color/elderly_brand_light"
        app:tabSelectedTextColor="@color/elderly_brand"
        app:tabTextColor="@color/elderly_text_secondary"
        app:tabTextAppearance="@style/ElderlyTabTextAppearance"
        app:tabIndicator="@drawable/bg_tab_indicator" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/elderly_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_community"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/elderly_padding_page"
        android:clipToPadding="false"
        android:background="@color/elderly_bg" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_add_post"
        android:layout_width="match_parent"
        android:layout_height="@dimen/elderly_button_height"
        android:layout_marginHorizontal="@dimen/elderly_padding_page"
        android:layout_marginVertical="@dimen/elderly_spacing_md"
        android:text="发布新动态"
        android:textSize="@dimen/elderly_text_body_large"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/elderly_brand"
        app:cornerRadius="@dimen/elderly_corner_radius_large"
        android:stateListAnimator="@null" />

</LinearLayout>