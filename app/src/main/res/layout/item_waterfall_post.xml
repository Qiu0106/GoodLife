<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/elderly_spacing_md"
    app:cardCornerRadius="@dimen/elderly_corner_radius_large"
    app:cardElevation="@dimen/elderly_card_elevation"
    app:cardBackgroundColor="@color/elderly_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/elderly_divider"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/elderly_padding_card">

        <ImageView
            android:id="@+id/iv_post_cover"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="@dimen/elderly_spacing_md" />

        <TextView
            android:id="@+id/tv_post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这是一个分享帖子的标题"
            android:textSize="@dimen/elderly_text_body_large"
            android:textColor="@color/elderly_text_primary"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.6"
            android:layout_marginBottom="@dimen/elderly_spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_user_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/elderly_spacing_sm"
                android:text="用户名"
                android:textSize="@dimen/elderly_text_body"
                android:textColor="@color/elderly_text_secondary" />

            <ImageView
                android:id="@+id/iv_like_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_heart_outline"
                android:padding="2dp" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/elderly_spacing_xs"
                android:text="0"
                android:textSize="@dimen/elderly_text_body"
                android:textColor="@color/elderly_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
