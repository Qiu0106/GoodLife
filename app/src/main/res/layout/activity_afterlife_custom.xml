<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/elderly_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="身后事定制"
        android:textSize="@dimen/elderly_text_title_large"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="@dimen/elderly_spacing_lg"
        android:paddingBottom="@dimen/elderly_spacing_lg"
        android:textColor="@color/elderly_text_primary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/elderly_padding_page" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/elderly_padding_page"
        android:paddingVertical="@dimen/elderly_spacing_md">

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="@dimen/elderly_button_height"
            android:text="下一步"
            android:textSize="@dimen/elderly_text_body_large"
            android:textStyle="bold"
            android:backgroundTint="@color/elderly_brand"
            android:textColor="@color/white"
            android:layout_marginBottom="@dimen/elderly_spacing_sm"
            android:visibility="visible" />

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="match_parent"
            android:layout_height="@dimen/elderly_button_height"
            android:text="上一步"
            android:textSize="@dimen/elderly_text_body_large"
            android:textStyle="bold"
            android:backgroundTint="@color/elderly_divider"
            android:textColor="@color/elderly_text_primary"
            android:layout_marginBottom="@dimen/elderly_spacing_sm"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/elderly_button_height"
            android:text="保存配置"
            android:textSize="@dimen/elderly_text_body_large"
            android:textStyle="bold"
            android:backgroundTint="@color/elderly_brand"
            android:textColor="@color/white"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
