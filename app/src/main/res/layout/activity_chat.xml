<?xml version="1.0" encoding="utf-8"?>
<!--
    语音助手聊天页面布局

    适老化设计要点：
    1. 大字号：消息内容 20sp，按钮 24sp
    2. 大触摸区域：输入框和发送按钮高度 >= 64dp
    3. 高对比度：用户气泡蓝色系，AI气泡灰色系
    4. 简洁层级：线性布局减少嵌套
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/morandi_bg">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/elderly_brand"
        android:paddingStart="@dimen/elderly_padding_page"
        android:paddingEnd="@dimen/elderly_spacing_sm"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI 语音助手"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- 消息列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/elderly_spacing_md"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:background="@color/morandi_bg" />

    <!-- 底部输入区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/elderly_spacing_md"
        android:background="@color/elderly_surface"
        android:elevation="8dp">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:hint="输入消息..."
            android:textSize="20sp"
            android:textColor="@color/elderly_text_primary"
            android:textColorHint="@color/elderly_text_hint"
            android:background="@drawable/bg_chat_input"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:maxLines="3"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_marginStart="@dimen/elderly_spacing_sm"
            android:text="发送"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_send"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>