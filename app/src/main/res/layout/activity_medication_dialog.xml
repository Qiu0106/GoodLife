<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:radius="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/morandi_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊"
                android:textSize="72sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用药提醒"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/morandi_text_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_medication_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="该吃药了：药物名称"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/elderly_error"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp" />

            <Button
                android:id="@+id/btn_taken"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="✅ 已服药"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/elderly_success"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_remind_later"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="⏰ 稍后提醒"
                android:textSize="22sp"
                android:textColor="@color/morandi_text_primary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>