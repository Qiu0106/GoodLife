<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/elderly_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/elderly_padding_page"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="@dimen/elderly_spacing_xl">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@mipmap/ic_launcher"
                app:civ_border_width="3dp"
                app:civ_border_color="@color/elderly_brand"
                android:layout_marginBottom="@dimen/elderly_spacing_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="好生活"
                android:textSize="@dimen/elderly_text_heading"
                android:textStyle="bold"
                android:textColor="@color/elderly_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="智能老年关怀平台"
                android:textSize="@dimen/elderly_text_body"
                android:textColor="@color/elderly_text_secondary"
                android:layout_marginTop="@dimen/elderly_spacing_xs" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="欢迎回来"
            android:textSize="@dimen/elderly_text_title_large"
            android:textStyle="bold"
            android:textColor="@color/elderly_text_primary"
            android:layout_marginBottom="@dimen/elderly_spacing_lg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手机号"
            style="@style/ElderlyInputLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_lg"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="false"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/elderly_input_height"
                android:background="@drawable/bg_elderly_input"
                android:hint="请输入手机号"
                android:inputType="phone"
                android:paddingHorizontal="@dimen/elderly_padding_input"
                android:textSize="@dimen/elderly_text_body_large"
                android:textColor="@color/elderly_text_primary"
                android:textColorHint="@color/elderly_text_hint"
    />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密码"
            style="@style/ElderlyInputLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_xl"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:errorEnabled="false"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/elderly_text_secondary"
            app:endIconMinSize="36dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/elderly_input_height"
                android:background="@drawable/bg_elderly_input"
                android:hint="请输入密码"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/elderly_padding_input"
                android:textSize="@dimen/elderly_text_body_large"
                android:textColor="@color/elderly_text_primary"
                android:textColorHint="@color/elderly_text_hint"
                 />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/elderly_button_height"
            android:text="登 录"
            android:textSize="@dimen/elderly_text_body_large"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/elderly_brand"
            app:cornerRadius="@dimen/elderly_corner_radius_large"
            android:stateListAnimator="@null"
            android:layout_marginBottom="@dimen/elderly_spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="@dimen/elderly_button_height"
            android:text="注 册 新 账 号"
            android:textSize="@dimen/elderly_text_body_large"
            android:textStyle="bold"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/elderly_brand"
            app:cornerRadius="@dimen/elderly_corner_radius_large"
            app:strokeColor="@color/elderly_brand"
            app:strokeWidth="2dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="@dimen/elderly_spacing_lg" />

        <TextView
            android:id="@+id/tvTestBmob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试 Bmob 连接"
            android:textColor="@color/elderly_text_hint"
            android:textSize="@dimen/elderly_text_small"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/elderly_spacing_lg"
            android:paddingVertical="@dimen/elderly_spacing_md"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</ScrollView>
