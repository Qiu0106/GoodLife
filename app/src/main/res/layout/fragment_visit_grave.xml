<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="预约看墓"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="预约日期"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/shape_search_bg"
            android:paddingHorizontal="16dp"
            android:hint="请输入日期 (YYYY-MM-DD)" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="预约时间"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/etTime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/shape_search_bg"
            android:paddingHorizontal="16dp"
            android:hint="请输入时间 (HH:MM)" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="预约目标"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/etVisitName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/shape_search_bg"
            android:paddingHorizontal="16dp"
            android:hint="请输入预约墓地名称"
            android:textSize="15sp"
            android:textColor="#333333"
            android:inputType="text" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveVisitInfo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="💾 保存预约信息"
        android:textSize="17sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/morandi_accent_warm"
        android:layout_marginBottom="12dp"
        app:cornerRadius="12dp" />

    <Button
        android:id="@+id/btnViewCemeteryMap"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="📍 查看上海市公墓地图"
        android:textSize="17sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/morandi_accent_warm"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="提示：点击上方按钮可查看上海市各公墓的位置信息，选择心仪的公墓后再填写预约信息。"
        android:textSize="13sp"
        android:textColor="@color/morandi_text_hint"
        android:lineSpacingMultiplier="1.4" />

</LinearLayout>