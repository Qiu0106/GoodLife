<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elderly_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="20dp"
            android:background="@color/elderly_surface">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="取消"
                android:textColor="@color/elderly_text_secondary"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@color/elderly_brand"
                android:text="发布"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/elderly_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:text="选择分区："
            android:textColor="@color/elderly_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="20dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_health"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="健康养生"
                android:textSize="18sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/elderly_input_bg"
                app:chipStrokeColor="@color/elderly_input_border"
                app:chipStrokeWidth="2dp"
                app:chipCornerRadius="28dp"
                app:checkedIconVisible="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_chat"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="日常闲聊"
                android:textSize="18sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/elderly_input_bg"
                app:chipStrokeColor="@color/elderly_input_border"
                app:chipStrokeWidth="2dp"
                app:chipCornerRadius="28dp"
                app:checkedIconVisible="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_activity"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="社区活动"
                android:textSize="18sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/elderly_input_bg"
                app:chipStrokeColor="@color/elderly_input_border"
                app:chipStrokeWidth="2dp"
                app:chipCornerRadius="28dp"
                app:checkedIconVisible="true"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/elderly_divider" />

        <EditText
            android:id="@+id/et_post_title"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_elderly_input"
            android:gravity="center_vertical"
            android:hint="请输入标题（必填）"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="@color/elderly_text_primary"
            android:textColorHint="@color/elderly_text_hint"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/elderly_divider" />

        <EditText
            android:id="@+id/et_post_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:background="@null"
            android:gravity="top|start"
            android:hint="分享你的生活和感悟..."
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="150dp"
            android:paddingVertical="12dp"
            android:textColor="@color/elderly_text_primary"
            android:textColorHint="@color/elderly_text_hint"
            android:textSize="20sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/elderly_divider" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/images_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <FrameLayout
                    android:id="@+id/btn_add_image"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_elderly_input"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/elderly_text_hint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:text="添加照片"
                        android:textColor="@color/elderly_text_hint"
                        android:textSize="18sp" />

                </FrameLayout>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>