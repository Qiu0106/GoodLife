<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/elderly_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/elderly_padding_page"
        android:paddingTop="@dimen/elderly_spacing_lg"
        android:paddingBottom="@dimen/elderly_spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/elderly_spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/elderly_spacing_sm">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@mipmap/ic_launcher"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@color/elderly_brand"
                    android:layout_marginEnd="@dimen/elderly_spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="早上好，用户"
                        android:textSize="@dimen/elderly_text_title"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary" />

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026年4月7日 星期二"
                        android:textSize="@dimen/elderly_text_body"
                        android:textColor="@color/elderly_text_secondary"
                        android:layout_marginTop="@dimen/elderly_spacing_xs" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weather_widget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_blue"
                    android:paddingHorizontal="@dimen/elderly_spacing_md"
                    android:paddingVertical="@dimen/elderly_spacing_sm"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="@dimen/elderly_spacing_xs">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="☀️"
                        android:textSize="22sp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tv_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26°C"
                        android:textSize="@dimen/elderly_text_body_large"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary"
                        android:layout_marginStart="@dimen/elderly_spacing_xs" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_checkin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/elderly_corner_radius_large"
            app:cardElevation="@dimen/elderly_card_elevation"
            app:cardBackgroundColor="@color/elderly_card_green"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/elderly_padding_card"
                android:minHeight="@dimen/elderly_card_min_height">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="📅"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/elderly_spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="打卡签到"
                        android:textSize="@dimen/elderly_text_body_large"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每日记录生活"
                        android:textSize="@dimen/elderly_text_body"
                        android:textColor="@color/elderly_text_secondary"
                        android:layout_marginTop="@dimen/elderly_spacing_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="→"
                    android:textSize="24sp"
                    android:textColor="@color/elderly_text_secondary"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_community"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/elderly_corner_radius_large"
            app:cardElevation="@dimen/elderly_card_elevation"
            app:cardBackgroundColor="@color/elderly_card_blue"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/elderly_padding_card"
                android:minHeight="@dimen/elderly_card_min_height">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="💬"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/elderly_spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="社区动态"
                        android:textSize="@dimen/elderly_text_body_large"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分享与交流"
                        android:textSize="@dimen/elderly_text_body"
                        android:textColor="@color/elderly_text_secondary"
                        android:layout_marginTop="@dimen/elderly_spacing_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="→"
                    android:textSize="24sp"
                    android:textColor="@color/elderly_text_secondary"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_afterlife"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/elderly_corner_radius_large"
            app:cardElevation="@dimen/elderly_card_elevation"
            app:cardBackgroundColor="@color/elderly_card_pink"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/elderly_padding_card"
                android:minHeight="@dimen/elderly_card_min_height">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🌸"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/elderly_spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="身后事定制"
                        android:textSize="@dimen/elderly_text_body_large"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="规划美好告别"
                        android:textSize="@dimen/elderly_text_body"
                        android:textColor="@color/elderly_text_secondary"
                        android:layout_marginTop="@dimen/elderly_spacing_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="→"
                    android:textSize="24sp"
                    android:textColor="@color/elderly_text_secondary"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_starry_sky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/elderly_corner_radius_large"
            app:cardElevation="@dimen/elderly_card_elevation"
            app:cardBackgroundColor="@color/elderly_card_purple"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/elderly_padding_card"
                android:minHeight="@dimen/elderly_card_min_height">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="⭐"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/elderly_spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="星空纪念馆"
                        android:textSize="@dimen/elderly_text_body_large"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="永恒的纪念"
                        android:textSize="@dimen/elderly_text_body"
                        android:textColor="@color/elderly_text_secondary"
                        android:layout_marginTop="@dimen/elderly_spacing_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="→"
                    android:textSize="24sp"
                    android:textColor="@color/elderly_text_secondary"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/elderly_spacing_md"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/elderly_corner_radius_large"
            app:cardElevation="@dimen/elderly_card_elevation"
            app:cardBackgroundColor="@color/elderly_card_orange"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/elderly_padding_card"
                android:minHeight="@dimen/elderly_card_min_height">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="👤"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/elderly_spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="我的中心"
                        android:textSize="@dimen/elderly_text_body_large"
                        android:textStyle="bold"
                        android:textColor="@color/elderly_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="个人信息 · 设置 · 退出登录"
                        android:textSize="@dimen/elderly_text_body"
                        android:textColor="@color/elderly_text_secondary"
                        android:layout_marginTop="@dimen/elderly_spacing_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="→"
                    android:textSize="24sp"
                    android:textColor="@color/elderly_text_secondary"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_voice_assistant"
            android:layout_width="match_parent"
            android:layout_height="@dimen/elderly_button_height"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/elderly_corner_radius_large"
            app:cardElevation="@dimen/elderly_card_elevation"
            app:cardBackgroundColor="@color/elderly_brand"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🎙️"
                    android:textSize="28sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="语音助手"
                    android:textSize="@dimen/elderly_text_body_large"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="@dimen/elderly_spacing_md" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击开始对话"
                    android:textSize="@dimen/elderly_text_body"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginStart="@dimen/elderly_spacing_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
