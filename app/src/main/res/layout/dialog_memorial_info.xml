<?xml version="1.0" encoding="utf-8"?>
<!--
    星空纪念馆 - 逝者信息弹窗布局

    设计理念：极致适老化设计
    1. 高对比度：深色磨砂背景 + 纯白高亮文字
    2. 大字号大间距：确保老年人清晰阅读
    3. 简洁结构：扁平化层级，减少视觉干扰
    4. 超大操作按钮：便于点击，不易误触
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_memorial"
    android:paddingTop="24dp"
    android:paddingBottom="32dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- 顶部装饰线（视觉引导） -->
    <View
        android:id="@+id/topIndicator"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_top_indicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 头像区域 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProfileImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="28dp"
        android:scaleType="centerCrop"
        android:background="@color/memorial_avatar_placeholder"
        android:padding="3dp"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:strokeColor="@color/memorial_accent"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toBottomOf="@id/topIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@tools:sample/avatars" />

    <!-- 星星图标装饰 -->
    <ImageView
        android:id="@+id/ivStarIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_star_memorial"
        android:contentDescription="纪念星"
        app:layout_constraintBottom_toBottomOf="@id/ivProfileImage"
        app:layout_constraintEnd_toEndOf="@id/ivProfileImage" />

    <!-- 逝者姓名 -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="36sp"
        android:textColor="@color/memorial_text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintTop_toBottomOf="@id/ivProfileImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="张爷爷" />

    <!-- 生卒年份 -->
    <TextView
        android:id="@+id/tvLifeYears"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="20sp"
        android:textColor="@color/memorial_text_secondary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1945年 - 2023年" />

    <!-- 分隔线 -->
    <View
        android:id="@+id/divider"
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:background="@color/memorial_divider"
        app:layout_constraintTop_toBottomOf="@id/tvLifeYears"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 寄语/简介标签 -->
    <TextView
        android:id="@+id/tvLabelMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="寄 语"
        android:textSize="18sp"
        android:textColor="@color/memorial_accent"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 寄语内容 -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="22sp"
        android:textColor="@color/memorial_text_primary"
        android:lineSpacingMultiplier="1.5"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="热爱生活的老人，喜欢园艺和钓鱼。一生勤勤恳恳，与人为善。" />

    <!-- 事迹标签 -->
    <TextView
        android:id="@+id/tvLabelStory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="事 迹"
        android:textSize="18sp"
        android:textColor="@color/memorial_accent"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 事迹内容 -->
    <TextView
        android:id="@+id/tvStory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="20sp"
        android:textColor="@color/memorial_text_secondary"
        android:lineSpacingMultiplier="1.6"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelStory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="张爷爷一生致力于社区志愿服务，帮助邻里修缮房屋，组织老年活动中心，深得居民爱戴。" />

    <!-- 献花祝福区域（情感化高亮按钮） -->
    <LinearLayout
        android:id="@+id/layoutFlowerAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_flower_button"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStory"
        app:layout_constraintBottom_toTopOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 献花图标 -->
        <ImageView
            android:id="@+id/ivFlowerIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_flower"
            android:contentDescription="献花" />

        <TextView
            android:id="@+id/tvFlowerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="献 花"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/memorial_text_primary" />

        <!-- 分隔竖线 -->
        <View
            android:layout_width="1.5dp"
            android:layout_height="32dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/memorial_divider" />

        <!-- 鲜花数量 -->
        <TextView
            android:id="@+id/tvFlowerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/memorial_accent"
            tools:text="128" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="次"
            android:textSize="20sp"
            android:textColor="@color/memorial_text_secondary" />

    </LinearLayout>

    <!-- 关闭按钮（辅助退出，深色低调设计） -->
    <Button
        android:id="@+id/btnClose"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:text="关 闭"
        android:textSize="24sp"
        android:textColor="@color/memorial_text_secondary"
        android:textStyle="bold"
        android:background="@drawable/bg_button_close"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/layoutFlowerAction"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>