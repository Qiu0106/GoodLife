<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SmartElderlyCareApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/elderly_brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/elderly_brand_light</item>
        <item name="colorOnPrimaryContainer">@color/elderly_brand_dark</item>
        <item name="colorError">@color/elderly_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/elderly_bg</item>
        <item name="colorOnBackground">@color/elderly_text_primary</item>
        <item name="colorSurface">@color/elderly_surface</item>
        <item name="colorOnSurface">@color/elderly_text_primary</item>
        <item name="android:statusBarColor">@color/elderly_bg</item>
        <item name="android:windowBackground">@color/elderly_bg</item>
        <item name="android:textViewStyle">@style/ElderlyTextView</item>
        <item name="android:editTextStyle">@style/ElderlyEditText</item>
        <item name="android:buttonStyle">@style/ElderlyButton</item>
    </style>

    <style name="Theme.SmartElderlyCareApp" parent="Base.Theme.SmartElderlyCareApp" />

    <style name="Theme.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="ElderlyTextView" parent="android:Widget.TextView">
        <item name="android:textSize">@dimen/elderly_text_body</item>
        <item name="android:textColor">@color/elderly_text_primary</item>
        <item name="android:lineSpacingMultiplier">@dimen/elderly_line_spacing_multiplier</item>
    </style>

    <style name="ElderlyEditText" parent="android:Widget.EditText">
        <item name="android:textSize">@dimen/elderly_text_body</item>
        <item name="android:textColor">@color/elderly_text_primary</item>
        <item name="android:minHeight">@dimen/elderly_input_height</item>
        <item name="android:paddingStart">@dimen/elderly_padding_input</item>
        <item name="android:paddingEnd">@dimen/elderly_padding_input</item>
        <item name="android:lineSpacingMultiplier">@dimen/elderly_line_spacing_multiplier</item>
    </style>

    <style name="ElderlyButton" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/elderly_text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/elderly_button_height</item>
        <item name="cornerRadius">@dimen/elderly_corner_radius</item>
    </style>

    <style name="ElderlyFullWidthButton" parent="ElderlyButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/elderly_button_height</item>
        <item name="cornerRadius">@dimen/elderly_corner_radius_large</item>
    </style>

    <style name="ElderlyCardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/elderly_corner_radius_large</item>
        <item name="cardElevation">@dimen/elderly_card_elevation</item>
        <item name="cardBackgroundColor">@color/elderly_surface</item>
    </style>

    <style name="ElderlyTitleText">
        <item name="android:textSize">@dimen/elderly_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/elderly_text_primary</item>
        <item name="android:lineSpacingMultiplier">@dimen/elderly_line_spacing_multiplier</item>
    </style>

    <style name="ElderlyHeadingText">
        <item name="android:textSize">@dimen/elderly_text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/elderly_text_primary</item>
        <item name="android:lineSpacingMultiplier">@dimen/elderly_line_spacing_multiplier</item>
    </style>

    <style name="ElderlyBodyText">
        <item name="android:textSize">@dimen/elderly_text_body</item>
        <item name="android:textColor">@color/elderly_text_primary</item>
        <item name="android:lineSpacingMultiplier">@dimen/elderly_line_spacing_multiplier</item>
    </style>

    <style name="ElderlyHintText">
        <item name="android:textSize">@dimen/elderly_text_hint</item>
        <item name="android:textColor">@color/elderly_text_hint</item>
        <item name="android:lineSpacingMultiplier">@dimen/elderly_line_spacing_multiplier</item>
    </style>

    <style name="ElderlyInputLabel">
        <item name="android:textSize">@dimen/elderly_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/elderly_text_primary</item>
        <item name="android:layout_marginBottom">@dimen/elderly_spacing_sm</item>
    </style>

    <style name="ElderlyRadioCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/elderly_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/elderly_surface</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/elderly_input_border</item>
    </style>

    <style name="ElderlyRadioCardSelected" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/elderly_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/elderly_brand_light</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/elderly_brand</item>
    </style>

    <style name="ElderlyTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/elderly_text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="ElderlyTabTextAppearance" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="ElderlyTabTextAppearanceSelected" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- 星空纪念馆 - 圆形头像样式 -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 适老化纪念星弹窗主题 -->
    <style name="MemorialBottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MemorialBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="MemorialBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/MemorialBottomSheetShape</item>
    </style>

    <style name="MemorialBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
